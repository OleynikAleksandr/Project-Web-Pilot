{
  "schema_version": 1,
  "profile": "DEVELOPMENT",
  "stack": "Electron 44.5.1 / Node 24.21.0 / Workflow Kit 1.5.1",
  "checks": [
    {
      "required": false,
      "timeout_ms": 120000,
      "id": "workflowkit-policy",
      "executable": "bash",
      "args": [
        "-lc",
        "cd ../WorkflowKit && test \"$(./scripts/workflow status | node -e 'let s=\"\";process.stdin.on(\"data\",d=>s+=d).on(\"end\",()=>process.stdout.write(JSON.parse(s).scope_status))')\" = NONE && npm run check"
      ]
    },
    {
      "required": false,
      "timeout_ms": 120000,
      "id": "startup-policy",
      "executable": "node",
      "args": [
        "--test",
        "tests/context-session.test.mjs"
      ]
    },
    {
      "required": false,
      "timeout_ms": 120000,
      "id": "integration-policy",
      "executable": "node",
      "args": [
        "--test",
        "tests/context-session.test.mjs",
        "tests/workflow-kit-recovery.test.mjs",
        "tests/workflow-kit-source.test.mjs"
      ]
    }
  ],
  "budget": {
    "soft_tokens": 16000,
    "hard_tokens": 90000,
    "hard_bytes": 180000
  },
  "documentation": {
    "index": "docs/DOCUMENTATION_INDEX.md",
    "mappings": [
      {
        "code": "src/**",
        "documents": [
          "docs/architecture/ARCHITECTURE.md"
        ]
      },
      {
        "code": "tests/**",
        "documents": [
          "docs/VERIFICATION.md"
        ]
      },
      {
        "code": "package*.json",
        "documents": [
          "docs/architecture/ARCHITECTURE.md"
        ]
      },
      {
        "code": ".gitignore",
        "documents": [
          "docs/architecture/ARCHITECTURE.md"
        ]
      }
    ]
  }
}
