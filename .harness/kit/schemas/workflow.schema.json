{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow configuration v1",
  "type": "object",
  "required": ["schema_version", "profile", "stack", "checks", "budget", "documentation"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"enum": ["DISCOVERY", "DEVELOPMENT"]},
    "stack": {"type": ["string", "null"]},
    "checks": {"type": "array", "items": {"type": "object", "required": ["id", "executable", "args", "required", "timeout_ms"], "properties": {"id": {"type": "string"}, "executable": {"type": "string"}, "args": {"type": "array", "items": {"type": "string"}}, "required": {"type": "boolean"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}, "stage": {"enum": ["commit", "push"]}}}},
    "budget": {"type": "object", "required": ["soft_tokens", "hard_tokens", "hard_bytes"], "properties": {"soft_tokens": {"type": "integer", "minimum": 1}, "hard_tokens": {"type": "integer", "minimum": 1}, "hard_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}}},
    "documentation": {"type": "object", "required": ["index", "mappings"]}
  }
}
