{
  "name": "@webpilot/workflow-kit",
  "version": "1.4.12",
  "private": true,
  "description": "Canonical Workflow Kit package for project plans, recovery, installation and session-owned workflows",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./cli": "./src/cli.mjs",
    "./install": "./src/install.mjs",
    "./lib/*": "./src/lib/*.mjs",
    "./schemas/*": "./src/schemas/*",
    "./templates/*": "./src/templates/*",
    "./examples/*": "./src/examples/*",
    "./WORKFLOW.md": "./src/WORKFLOW.md"
  },
  "bin": {
    "workflow": "./src/cli.mjs"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check-package.mjs"
  }
}
