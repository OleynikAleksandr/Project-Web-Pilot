{
  "name": "project-web-pilot",
  "productName": "Project Web Pilot",
  "version": "0.4.0",
  "description": "Локальный проект и ChatGPT в одном окне",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "author": "Oleksandr Oliinyk",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke": "electron . --smoke",
    "build": "electron-packager . 'Project Web Pilot' --platform=darwin --arch=arm64 --out=.harness/runtime/build --overwrite --app-bundle-id=com.oleynik.ProjectWebPilot --app-version=0.4.0 --asar --extra-resource=resources --ignore='^/(resources|docs|tests|scripts|\\.harness|\\.git|\\.codex|AGENTS\\.md|README\\.md)'"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.3.0",
    "jsdom": "26.1.0"
  }
}
